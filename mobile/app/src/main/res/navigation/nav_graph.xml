<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/memoriesFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.memorylane.feature.auth.ui.LoginFragment"
        android:label="@string/login_submit">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.memorylane.feature.auth.ui.RegisterFragment"
        android:label="@string/register_badge" />

    <fragment
        android:id="@+id/memoriesFragment"
        android:name="com.memorylane.feature.memories.ui.MemoriesFragment"
        android:label="@string/tab_memories">
        <action
            android:id="@+id/action_memoriesFragment_to_memoryCreateFragment"
            app:destination="@id/memoryCreateFragment" />
        <action
            android:id="@+id/action_memoriesFragment_to_memoryDetailFragment"
            app:destination="@id/memoryDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/memoryDetailFragment"
        android:name="com.memorylane.feature.memories.ui.MemoryDetailFragment"
        android:label="@string/memory_detail_title">
        <argument
            android:name="memoryId"
            app:argType="string" />
        <action
            android:id="@+id/action_memoryDetailFragment_to_memoryPhotoViewerFragment"
            app:destination="@id/memoryPhotoViewerFragment" />
        <action
            android:id="@+id/action_memoryDetailFragment_to_memoryEditFragment"
            app:destination="@id/memoryEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/memoryEditFragment"
        android:name="com.memorylane.feature.memories.ui.MemoryEditFragment"
        android:label="@string/memory_edit_title">
        <argument
            android:name="memoryId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/memoryPhotoViewerFragment"
        android:name="com.memorylane.feature.memories.ui.MemoryPhotoViewerFragment"
        android:label="@string/memory_viewer_label">
        <argument
            android:name="memoryId"
            app:argType="string" />
        <argument
            android:name="photoIds"
            app:argType="string[]" />
        <argument
            android:name="initialPosition"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="title"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="memoryDate"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/memoryCreateFragment"
        android:name="com.memorylane.feature.memories.ui.MemoryCreateFragment"
        android:label="@string/memory_create_label" />

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.memorylane.feature.map.ui.MapFragment"
        android:label="@string/tab_map" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.memorylane.feature.profile.ui.ProfileFragment"
        android:label="@string/tab_profile">
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
</navigation>
