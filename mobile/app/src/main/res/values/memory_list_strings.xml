<?xml version="1.0" encoding="utf-8"?>
<!-- Memory list screen (ML-07). -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="tr">
    <!-- Header -->
    <string name="memory_list_badge">Kişisel Günlük &amp; Arşiv</string>
    <string name="memory_list_subtitle">Güzel anılarını güvenle ve sevgiyle biriktir.</string>
    <!-- Small note at the end of each year line and after the last memory. -->
    <string name="memory_list_year_note">anı defteri</string>
    <string name="memory_list_end">Geçmişin güzellikleri burada korunuyor.</string>

    <!-- Loading and paging -->
    <string name="memory_list_loading">Anıların yükleniyor…</string>
    <string name="memory_list_loading_more">Daha fazla anı yükleniyor…</string>
    <string name="memory_list_load_more">Daha fazla anı göster</string>

    <!-- Empty, error and signed-out states -->
    <string name="memory_list_empty_title">Henüz anın yok</string>
    <string name="memory_list_empty_message">İlk anını eklemek için “Anı Ekle” düğmesine dokun.</string>
    <string name="memory_list_error_title">Anılar yüklenemedi</string>
    <string name="memory_list_signed_out_title">Anıların seni bekliyor</string>
    <string name="memory_list_signed_out_message">Anılarını görmek ve yenilerini eklemek için giriş yap.</string>
    <string name="memory_list_sign_in">Giriş yap</string>
    <string name="memory_list_session_expired">Oturumun sona erdi. Devam etmek için tekrar giriş yap.</string>

    <!-- Year header: the year itself is shown as a number; this is what TalkBack reads. -->
    <string name="memory_list_year_description">%1$d yılındaki anılar</string>

    <!-- Add button -->
    <string name="memory_list_add">Anı Ekle</string>
    <string name="memory_list_add_description">Yeni anı ekle</string>

    <!-- Card date, e.g. "28 Ekim 2024"; formatted with the Turkish locale. -->
    <string name="memory_list_date_pattern" translatable="false">d MMMM yyyy</string>
</resources>
