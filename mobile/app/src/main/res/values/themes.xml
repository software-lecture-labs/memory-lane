<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Single app theme: Material components pick up the design tokens from here,
         so a palette change is made once instead of in every layout. -->
    <style name="Theme.MemoryLane" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ml_primary</item>
        <item name="colorOnPrimary">@color/ml_on_primary</item>
        <item name="colorPrimaryContainer">@color/ml_lavender</item>
        <item name="colorOnPrimaryContainer">@color/ml_plum</item>
        <item name="colorSecondary">@color/ml_lavender</item>
        <item name="colorOnSecondary">@color/ml_plum</item>
        <item name="colorSecondaryContainer">@color/ml_lavender</item>
        <item name="colorOnSecondaryContainer">@color/ml_plum</item>
        <item name="colorSurface">@color/ml_surface</item>
        <item name="colorOnSurface">@color/ml_plum</item>
        <item name="colorOnSurfaceVariant">@color/ml_plum_muted</item>
        <item name="colorOutline">@color/ml_outline</item>
        <item name="colorError">@color/ml_error</item>
        <item name="android:colorBackground">@color/ml_canvas</item>
        <item name="android:windowBackground">@color/ml_canvas</item>
        <item name="android:textColorPrimary">@color/ml_plum</item>
        <item name="android:textColorSecondary">@color/ml_plum_muted</item>
        <item name="android:textColorHint">@color/ml_plum_hint</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>

        <item name="materialButtonStyle">@style/Widget.MemoryLane.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.MemoryLane.Card</item>
        <item name="textInputStyle">@style/Widget.MemoryLane.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.MemoryLane.BottomNavigation</item>
    </style>
</resources>
