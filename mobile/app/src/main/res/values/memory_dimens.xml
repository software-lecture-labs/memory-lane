<?xml version="1.0" encoding="utf-8"?>
<!-- Memory screens' sizes. Shared spacing and radii stay in dimens.xml. -->
<resources>
    <!-- Bottom list padding so the last card can scroll above the add button
         (56dp button + 16dp margin above and below + 8dp gap). -->
    <dimen name="memory_list_bottom_padding">96dp</dimen>
    <!-- Gap between the header and a loading, empty, error or signed-out message. -->
    <dimen name="memory_status_top">48dp</dimen>

    <!-- Scrapbook card (Stitch: rounded-3xl = 32dp). The shared Widget.MemoryLane.Card keeps 24dp. -->
    <dimen name="memory_card_radius">32dp</dimen>
    <dimen name="memory_card_title">17sp</dimen>
    <dimen name="memory_card_stripe">6dp</dimen>
    <dimen name="memory_note_text">14sp</dimen>
    <dimen name="memory_icon_inline">16dp</dimen>
    <dimen name="memory_icon_label">18dp</dimen>

    <!-- Washi tape over the top edge of a list card. -->
    <dimen name="memory_tape_width">80dp</dimen>
    <dimen name="memory_tape_height">14dp</dimen>
    <dimen name="memory_tape_corner">2dp</dimen>
    <dimen name="memory_tape_overlap">7dp</dimen>
    <dimen name="memory_tape_elevation">6dp</dimen>

    <dimen name="memory_year_badge">32dp</dimen>
    <dimen name="memory_year_rule">4dp</dimen>
    <!-- Create screen: round close button and the lavender circle behind the calendar icon. -->
    <dimen name="memory_create_icon_box">44dp</dimen>
</resources>
