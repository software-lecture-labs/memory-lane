<?xml version="1.0" encoding="utf-8"?>
<!-- Memory list sizes. Shared spacing and radii stay in dimens.xml.
     tools:ignore="UnusedResources" is dropped once a layout references the size. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Bottom list padding so the last card can scroll above the add button
         (56dp button + 16dp margin above and below + 8dp gap). -->
    <dimen name="memory_list_bottom_padding" tools:ignore="UnusedResources">96dp</dimen>
    <dimen name="memory_card_title" tools:ignore="UnusedResources">17sp</dimen>
    <dimen name="memory_icon_inline" tools:ignore="UnusedResources">16dp</dimen>
    <dimen name="memory_year_badge" tools:ignore="UnusedResources">32dp</dimen>
    <dimen name="memory_year_rule" tools:ignore="UnusedResources">4dp</dimen>
</resources>
