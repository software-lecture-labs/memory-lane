    <stroke
        android:width="@dimen/ml_stroke_thin"
        android:color="@color/ml_primary"
        android:dashWidth="3dp"
        android:dashGap="2dp" />
    <corners android:radius="@dimen/calendar_cell_radius" />
</shape>
