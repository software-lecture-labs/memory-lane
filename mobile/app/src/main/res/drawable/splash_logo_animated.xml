<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ launch screen icon: the Memory Lane mark (ic_logo_mark) arrives small and twisted,
     settles flat with a slight overshoot, then its washi tape is pressed on, the same motion as
     the login screen logo. The splash icon is 288dp with its content inside the 192dp circle,
     so the 60dp mark is drawn 2.5x (150dp) in the middle. Vector paths cannot include another
     drawable, so the mark's paths are repeated from ic_logo_mark. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="288"
            android:viewportHeight="288">

            <!-- Start values match the first animation frame, so nothing jumps. -->
            <group
                android:name="drop"
                android:pivotX="144"
                android:pivotY="144"
                android:rotation="-18"
                android:scaleX="0.6"
                android:scaleY="0.6">
                <group
                    android:scaleX="2.5"
                    android:scaleY="2.5"
                    android:translateX="69"
                    android:translateY="69">

                    <group
                        android:pivotX="30"
                        android:pivotY="31"
                        android:rotation="-8"
                        android:scaleX="0.92"
                        android:scaleY="0.92">
                        <path
                            android:fillColor="#2635263F"
                            android:pathData="M11.5,6.5h38a3,3 0,0 1,3 3v46a3,3 0,0 1,-3 3h-38a3,3 0,0 1,-3 -3v-46a3,3 0,0 1,3 -3z" />
                        <path
                            android:fillColor="#FFFFFF"
                            android:strokeColor="#F0D7E8"
                            android:strokeWidth="0.6"
                            android:pathData="M10,5h38a3,3 0,0 1,3 3v46a3,3 0,0 1,-3 3h-38a3,3 0,0 1,-3 -3v-46a3,3 0,0 1,3 -3z" />
                        <path android:pathData="M11.5,9.5h35v35h-35z">
                            <aapt:attr name="android:fillColor">
                                <gradient
                                    android:type="linear"
                                    android:startX="29"
                                    android:startY="9.5"
                                    android:endX="29"
                                    android:endY="44.5"
                                    android:startColor="#DCCEFF"
                                    android:endColor="#FFD0B5" />
                            </aapt:attr>
                        </path>
                        <path
                            android:fillColor="#FFE69A"
                            android:pathData="M39,20.5m-4.5,0a4.5,4.5 0,1 1,9 0a4.5,4.5 0,1 1,-9 0" />
                        <path
                            android:fillColor="#F6B8D2"
                            android:pathData="M11.5,32C18,27 25,28.5 31,31.5C36,34 41,31 46.5,29V44.5H11.5Z" />
                        <path
                            android:fillColor="#EE8FB6"
                            android:pathData="M11.5,38C20,34.5 32,37.5 46.5,35V44.5H11.5Z" />
                        <path
                            android:fillColor="#D93678"
                            android:pathData="M22,44.5C22.5,40.5 30,40 30.5,36.5C30.8,34.4 27.4,33.6 27.6,31.4L28.6,31.4C28.6,33.2 32.4,34.2 32.3,36.8C32.1,40.6 27,41.2 27.5,44.5Z" />
                        <path
                            android:fillColor="#D93678"
                            android:pathData="M28.1,30.2l-2.3,-2.2a1.45,1.45 0,0 1,2.3 -1.75a1.45,1.45 0,0 1,2.3 1.75z" />
                        <path
                            android:strokeColor="#8035263F"
                            android:strokeWidth="1.1"
                            android:strokeLineCap="round"
                            android:pathData="M15,50.5q2.5,-1.6 5,0t5,0t5,0" />
                    </group>

                    <group
                        android:name="tape"
                        android:pivotX="30"
                        android:pivotY="6"
                        android:rotation="5"
                        android:scaleX="0">
                        <path
                            android:fillColor="#D9FFE69A"
                            android:pathData="M21,3h18v6.5h-18z" />
                    </group>
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="drop">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="620"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="rotation"
                    android:valueFrom="-18"
                    android:valueTo="0" />
                <objectAnimator
                    android:duration="620"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleX"
                    android:valueFrom="0.6"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="620"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleY"
                    android:valueFrom="0.6"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="tape">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="240"
                android:interpolator="@android:anim/decelerate_interpolator"
                android:propertyName="scaleX"
                android:startOffset="520"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
</animated-vector>
