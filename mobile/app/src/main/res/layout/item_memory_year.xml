<?xml version="1.0" encoding="utf-8"?>
<!-- Year line of the timeline (Stitch "Anılar"): a node on the guide line (raspberry, or plum
     for odd years, set from code), the year in a lavender pill and a short note. The guide line
     itself is drawn by MemoryTimelineDecoration. TalkBack reads the row as one heading. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/ml_space_sm"
    android:paddingBottom="@dimen/ml_space_md">

    <View
        android:id="@+id/memory_year_node"
        android:layout_width="@dimen/memory_timeline_node"
        android:layout_height="@dimen/memory_timeline_node"
        android:background="@drawable/memory_timeline_node"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/memory_year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ml_space_sm"
        android:background="@drawable/memory_pill_lavender"
        android:importantForAccessibility="no"
        android:paddingHorizontal="@dimen/memory_year_pill_padding_h"
        android:paddingVertical="@dimen/ml_space_xs"
        android:textAppearance="@style/TextAppearance.MemoryLane.Label.Bold"
        tools:text="2026" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ml_space_sm"
        android:importantForAccessibility="no"
        android:text="@string/memory_list_year_note"
        android:textAppearance="@style/TextAppearance.MemoryLane.Note" />
</LinearLayout>
