<?xml version="1.0" encoding="utf-8"?>
<!-- One "on this day" memory: how many years ago, its title, and a chevron; tapping opens that
     day in the calendar. The spoken text is set from code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/ml_button_height"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/reminder_years"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/memory_pill_pink"
        android:importantForAccessibility="no"
        android:paddingHorizontal="@dimen/ml_space_sm"
        android:paddingVertical="2dp"
        android:textAppearance="@style/TextAppearance.MemoryLane.Label.Bold"
        android:textColor="@color/ml_primary"
        tools:text="1 yıl önce" />

    <TextView
        android:id="@+id/reminder_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ml_space_sm"
        android:layout_weight="1"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.MemoryLane.CardTitle"
        tools:text="Kadıköy'de kahve molası" />

    <ImageView
        android:layout_width="@dimen/memory_icon_label"
        android:layout_height="@dimen/memory_icon_label"
        android:importantForAccessibility="no"
        android:src="@drawable/calendar_next"
        app:tint="@color/ml_plum_muted" />
</LinearLayout>
