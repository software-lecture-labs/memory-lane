<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ml_space_lg"
        android:gravity="center_horizontal"
        android:focusableInTouchMode="true">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_sm"
            android:background="@drawable/login_badge"
            android:elevation="@dimen/ml_card_elevation"
            android:gravity="center"
            android:paddingHorizontal="@dimen/ml_space_md"
            android:paddingVertical="@dimen/ml_space_sm">
            <ImageView
                android:layout_width="@dimen/login_badge_icon_size"
                android:layout_height="@dimen/login_badge_icon_size"
                android:background="@drawable/login_icon_circle"
                android:padding="@dimen/login_icon_padding"
                android:src="@drawable/login_book"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ml_space_sm"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.MemoryLane.Button"
                android:textColor="@color/ml_primary" />
            <ImageView
                android:layout_width="@dimen/ml_space_md"
                android:layout_height="@dimen/login_decoration_height"
                android:layout_marginStart="@dimen/ml_space_xs"
                android:src="@drawable/login_sparkle"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_title_margin_top"
            android:gravity="center"
            android:id="@+id/login_heading"
            android:text="@string/login_welcome"
            android:textAppearance="@style/TextAppearance.MemoryLane.Headline" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_sm"
            android:gravity="center"
            android:text="@string/login_subtitle"
            android:textAppearance="@style/TextAppearance.MemoryLane.Body.Muted" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_header_gap"
            android:layout_marginBottom="@dimen/ml_space_lg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/login_card_shadow_space">
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MemoryLane.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_card_margin_top"
                app:cardElevation="@dimen/login_card_elevation"
                app:contentPadding="@dimen/login_card_content_inset">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/login_card_padding">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/email_input"
                        android:text="@string/login_email"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Body"
                        android:textSize="@dimen/ml_text_label"
                        android:layout_marginTop="@dimen/ml_space_sm" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/email_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_sm"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:startIconDrawable="@drawable/login_email"
                        app:startIconTint="@color/login_icon"
                        app:boxStrokeColor="@color/login_input_stroke">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/email_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/login_email_placeholder"
                            android:textSize="@dimen/ml_text_body_small"
                            android:minHeight="@dimen/ml_button_height"
                            android:autofillHints="emailAddress"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionNext"
                            android:maxLines="1"
                            android:saveEnabled="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/password_input"
                        android:text="@string/login_password"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Body"
                        android:textSize="@dimen/ml_text_label" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/password_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_sm"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:startIconDrawable="@drawable/login_lock"
                        app:startIconTint="@color/login_icon"
                        app:endIconTint="@color/login_icon"
                        app:boxStrokeColor="@color/login_input_stroke"
                        app:endIconMode="password_toggle"
                        app:endIconContentDescription="@string/login_show_password">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/ml_text_body_small"
                            android:minHeight="@dimen/ml_button_height"
                            android:autofillHints="password"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone"
                            android:maxLines="1"
                            android:saveEnabled="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/login_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/ml_button_height"
                        android:elevation="@dimen/login_button_elevation"
                        android:layout_marginTop="@dimen/ml_space_sm"
                        android:layout_marginBottom="@dimen/ml_space_sm"
                        android:text="@string/login_submit"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Button"
                        app:backgroundTint="@color/ml_primary"
                        app:icon="@drawable/login_arrow"
                        app:iconGravity="textEnd" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <View
                android:layout_width="@dimen/login_tape_width"
                android:layout_height="@dimen/login_decoration_height"
                android:layout_gravity="top|center_horizontal"
                android:rotation="-2"
                android:elevation="@dimen/login_tape_elevation"
                android:background="@drawable/login_tape"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
