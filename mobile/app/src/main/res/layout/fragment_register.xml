<?xml version="1.0" encoding="utf-8"?>
<!-- Register screen; mirrors fragment_login.xml and reuses its shared login_* resources. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ml_space_lg"
        android:gravity="center_horizontal"
        android:focusableInTouchMode="true">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="@dimen/ml_button_height"
                android:layout_height="@dimen/ml_button_height"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/register_back_button"
                android:contentDescription="@string/register_back"
                android:scaleType="center"
                android:src="@drawable/register_back" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/login_badge"
                android:elevation="@dimen/ml_card_elevation"
                android:gravity="center"
                android:paddingHorizontal="@dimen/ml_space_md"
                android:paddingVertical="@dimen/ml_space_sm">
                <ImageView
                    android:layout_width="@dimen/login_badge_icon_size"
                    android:layout_height="@dimen/login_badge_icon_size"
                    android:background="@drawable/login_icon_circle"
                    android:padding="@dimen/login_icon_padding"
                    android:src="@drawable/login_book"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ml_space_sm"
                    android:text="@string/register_badge"
                    android:textAppearance="@style/TextAppearance.MemoryLane.Button"
                    android:textColor="@color/ml_primary" />
                <ImageView
                    android:layout_width="@dimen/ml_space_md"
                    android:layout_height="@dimen/login_decoration_height"
                    android:layout_marginStart="@dimen/ml_space_xs"
                    android:src="@drawable/login_sparkle"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </FrameLayout>
        <TextView
            android:id="@+id/register_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_title_margin_top"
            android:gravity="center"
            android:text="@string/register_title"
            android:textAppearance="@style/TextAppearance.MemoryLane.Headline" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_sm"
            android:gravity="center"
            android:text="@string/register_subtitle"
            android:textAppearance="@style/TextAppearance.MemoryLane.Body.Muted" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_lg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/login_card_shadow_space">
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MemoryLane.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_card_margin_top"
                app:cardElevation="@dimen/login_card_elevation"
                app:contentPadding="@dimen/login_card_content_inset">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/login_card_padding">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_sm"
                        android:labelFor="@id/email_input"
                        android:text="@string/login_email"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Body"
                        android:textSize="@dimen/ml_text_label" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/email_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_sm"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:startIconDrawable="@drawable/login_email"
                        app:startIconTint="@color/login_icon"
                        app:boxStrokeColor="@color/login_input_stroke">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/email_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/login_email_placeholder"
                            android:textSize="@dimen/ml_text_body_small"
                            android:minHeight="@dimen/ml_button_height"
                            android:autofillHints="emailAddress"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionNext"
                            android:maxLines="1"
                            android:saveEnabled="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/password_input"
                        android:text="@string/login_password"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Body"
                        android:textSize="@dimen/ml_text_label" />
                    <!-- The rule shows as helper text; Material swaps it for the error message and back. -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/password_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_sm"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:helperTextEnabled="true"
                        app:helperText="@string/register_password_rule"
                        app:startIconDrawable="@drawable/login_lock"
                        app:startIconTint="@color/login_icon"
                        app:endIconTint="@color/login_icon"
                        app:boxStrokeColor="@color/login_input_stroke"
                        app:endIconMode="password_toggle"
                        app:endIconContentDescription="@string/login_show_password">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/ml_text_body_small"
                            android:minHeight="@dimen/ml_button_height"
                            android:autofillHints="newPassword"
                            android:inputType="textPassword"
                            android:imeOptions="actionNext"
                            android:maxLines="1"
                            android:saveEnabled="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_sm"
                        android:labelFor="@id/confirm_input"
                        android:text="@string/register_password_confirm"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Body"
                        android:textSize="@dimen/ml_text_label" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/confirm_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_sm"
                        app:hintEnabled="false"
                        app:errorEnabled="true"
                        app:startIconDrawable="@drawable/login_lock"
                        app:startIconTint="@color/login_icon"
                        app:endIconTint="@color/login_icon"
                        app:boxStrokeColor="@color/login_input_stroke"
                        app:endIconMode="password_toggle"
                        app:endIconContentDescription="@string/login_show_password">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/confirm_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/ml_text_body_small"
                            android:minHeight="@dimen/ml_button_height"
                            android:autofillHints="newPassword"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone"
                            android:maxLines="1"
                            android:saveEnabled="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <!-- Server errors that belong to no single field (network, 429, 503). -->
                    <TextView
                        android:id="@+id/register_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ml_space_sm"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Body"
                        android:textColor="@color/ml_error"
                        android:textSize="@dimen/ml_text_label"
                        android:visibility="gone" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/register_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ml_space_sm"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/ml_primary"
                        app:trackColor="@color/ml_lavender" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/register_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/ml_button_height"
                        android:elevation="@dimen/login_button_elevation"
                        android:layout_marginTop="@dimen/ml_space_sm"
                        android:layout_marginBottom="@dimen/ml_space_sm"
                        android:text="@string/register_submit"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Button"
                        app:backgroundTint="@color/ml_primary"
                        app:icon="@drawable/login_arrow"
                        app:iconGravity="textEnd" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <View
                android:layout_width="@dimen/login_tape_width"
                android:layout_height="@dimen/login_decoration_height"
                android:layout_gravity="top|center_horizontal"
                android:rotation="-2"
                android:elevation="@dimen/login_tape_elevation"
                android:background="@drawable/login_tape"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ml_space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_have_account"
                android:textAppearance="@style/TextAppearance.MemoryLane.Body.Muted"
                android:textSize="@dimen/ml_text_label" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/login_link"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ml_button_height"
                android:paddingHorizontal="@dimen/ml_space_xs"
                android:text="@string/register_go_login"
                android:textAppearance="@style/TextAppearance.MemoryLane.Button"
                android:textColor="@color/ml_primary" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
