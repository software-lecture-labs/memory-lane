<?xml version="1.0" encoding="utf-8"?>
<!-- Photo picking and upload status for the memory form (ML-10). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ml_space_sm"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/photo_add"
        style="@style/Widget.MemoryLane.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Fotoğraf ekle (5 hakkın kaldı)" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ml_space_xs"
        android:text="@string/photo_hint"
        android:textAppearance="@style/TextAppearance.MemoryLane.Body.Muted" />

    <LinearLayout
        android:id="@+id/photo_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ml_space_sm"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/photo_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ml_space_xs"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.MemoryLane.Body"
        tools:text="Anı kaydedildi, 2 fotoğraf yüklenemedi." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/photo_retry"
        style="@style/Widget.MemoryLane.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ml_space_sm"
        android:text="@string/photo_retry"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/photo_give_up"
        style="@style/Widget.MemoryLane.Button.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/photo_give_up"
        android:visibility="gone" />
</LinearLayout>
