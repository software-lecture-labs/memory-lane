<?xml version="1.0" encoding="utf-8"?>
<!-- New memory: title, date and description cards, following the Stitch "Anı oluşturma" screen.
     Location, photos, mood and category belong to later cards and are left out. The bottom
     inset (gesture bar or keyboard) is applied by MainActivity, so the form scrolls above it. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="@dimen/ml_space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/create_back"
                android:layout_width="@dimen/ml_button_height"
                android:layout_height="@dimen/ml_button_height"
                android:background="@drawable/memory_create_back_bg"
                android:contentDescription="@string/memory_create_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ml_plum" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ml_space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/memory_year_badge"
                    android:paddingHorizontal="@dimen/ml_space_sm"
                    android:paddingVertical="@dimen/ml_space_xs"
                    android:text="@string/memory_create_badge"
                    android:textAppearance="@style/TextAppearance.MemoryLane.Caption"
                    android:textColor="@color/ml_primary" />

                <TextView
                    android:id="@+id/create_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ml_space_xs"
                    android:text="@string/memory_create_heading"
                    android:textAppearance="@style/TextAppearance.MemoryLane.Headline" />
            </LinearLayout>
        </LinearLayout>

        <!-- Title -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_lg"
            app:strokeColor="@color/memory_card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/create_title_input"
                    android:text="@string/memory_create_title_label"
                    android:textAppearance="@style/TextAppearance.MemoryLane.Label"
                    android:textColor="@color/ml_primary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/create_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ml_space_sm"
                    app:counterEnabled="true"
                    app:counterMaxLength="100"
                    app:errorEnabled="true"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/create_title_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/memory_create_title_hint"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences"
                        android:maxLines="2"
                        android:minHeight="@dimen/ml_button_height"
                        android:saveEnabled="false"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Body" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Date: the whole card opens the date picker. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/create_date_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_md"
            android:clickable="true"
            android:focusable="true"
            app:strokeColor="@color/memory_card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/memory_create_icon_box"
                    android:layout_height="@dimen/memory_create_icon_box"
                    android:background="@drawable/memory_create_date_icon_bg"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/ml_space_sm"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/ml_plum" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ml_space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/memory_create_date_label"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Caption" />

                    <TextView
                        android:id="@+id/create_date_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Label"
                        tools:text="24 Ekim 2024" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/memory_create_date_change"
                    android:textAppearance="@style/TextAppearance.MemoryLane.Label"
                    android:textColor="@color/ml_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/create_date_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_xs"
            android:accessibilityLiveRegion="polite"
            android:paddingHorizontal="@dimen/ml_space_md"
            android:textAppearance="@style/TextAppearance.MemoryLane.Caption"
            android:textColor="@color/ml_error"
            android:visibility="gone"
            tools:text="@string/memory_create_date_required"
            tools:visibility="visible" />

        <!-- Description -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_md"
            app:strokeColor="@color/memory_card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/create_description_input"
                    android:text="@string/memory_create_description_label"
                    android:textAppearance="@style/TextAppearance.MemoryLane.Label"
                    android:textColor="@color/ml_primary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/create_description_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ml_space_sm"
                    app:counterEnabled="true"
                    app:counterMaxLength="3000"
                    app:errorEnabled="true"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/create_description_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="@string/memory_create_description_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="4"
                        android:saveEnabled="false"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Body" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Server errors that belong to no single field (network, 503, server validation). -->
        <TextView
            android:id="@+id/create_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_md"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.MemoryLane.Body.Muted"
            android:textColor="@color/ml_error"
            android:visibility="gone"
            tools:text="@string/error_network"
            tools:visibility="visible" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/create_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_md"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/create_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_md"
            android:text="@string/memory_create_save" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
