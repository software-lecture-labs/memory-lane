<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/ml_space_md">

    <com.memorylane.core.ui.widget.ScreenHeaderView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerSubtitle="@string/map_subtitle"
        app:headerTitle="@string/map_title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ml_space_lg"
        android:text="@string/screen_not_ready"
        android:textAppearance="@style/TextAppearance.MemoryLane.Body" />
</LinearLayout>
