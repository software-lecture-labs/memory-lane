<?xml version="1.0" encoding="utf-8"?>
<!-- Profile tab: the session (sign in / sign out) and the server health check. Uses the same
     scrapbook cards as the memory screens. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ml_space_md">

        <com.memorylane.core.ui.widget.ScreenHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:headerSubtitle="@string/profile_subtitle"
            app:headerTitle="@string/profile_title" />

        <!-- Session -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_lg"
            android:text="@string/profile_session_title"
            android:textAppearance="@style/TextAppearance.MemoryLane.Label" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MemoryLane.Card.Scrapbook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_session_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.MemoryLane.Body"
                    tools:text="@string/profile_signed_in" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_sign_in"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ml_space_md"
                    android:text="@string/profile_sign_in"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_sign_out"
                    style="@style/Widget.MemoryLane.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ml_space_md"
                    android:text="@string/profile_sign_out"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Server health -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_lg"
            android:text="@string/health_section_title"
            android:textAppearance="@style/TextAppearance.MemoryLane.Label" />

        <!-- Shown only after a successful health response. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/health_card"
            style="@style/Widget.MemoryLane.Card.Scrapbook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_sm"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/ml_icon_status"
                    android:layout_height="@dimen/ml_icon_status"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_status_ok" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ml_space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/health_ok_title"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Label.Bold" />

                    <TextView
                        android:id="@+id/health_database"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_xs"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Body.Muted"
                        tools:text="Veritabanı: UP" />

                    <TextView
                        android:id="@+id/health_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Body.Muted"
                        tools:text="Adres: http://10.0.2.2:8080/" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.memorylane.core.ui.widget.StateView
            android:id="@+id/health_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_md" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
