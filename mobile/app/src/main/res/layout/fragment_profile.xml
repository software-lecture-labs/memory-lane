<?xml version="1.0" encoding="utf-8"?>
<!-- Profile tab laid out like a settings screen: the notebook owner at the top, then grouped
     rows (account, app) on scrapbook cards, and signing out at the end, away from the rest. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="@dimen/ml_space_md">

        <com.memorylane.core.ui.widget.ScreenHeaderView
            android:id="@+id/profile_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:headerSubtitle="@string/profile_subtitle"
            app:headerTitle="@string/profile_title" />

        <!-- Owner card with a strip of washi tape over its top edge. -->
        <FrameLayout
            android:id="@+id/profile_owner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_lg"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MemoryLane.Card.Scrapbook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/memory_tape_overlap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/ml_space_md"
                    android:paddingBottom="@dimen/ml_space_sm">

                    <!-- Initial of the e-mail, with the app mark pinned to its corner. The even
                         padding is room for the mark to hang over the ring without being clipped. -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:importantForAccessibility="noHideDescendants"
                        android:padding="@dimen/profile_avatar_badge_room">

                        <TextView
                            android:id="@+id/profile_initial"
                            android:layout_width="@dimen/profile_avatar_size"
                            android:layout_height="@dimen/profile_avatar_size"
                            android:background="@drawable/profile_avatar"
                            android:elevation="@dimen/ml_card_elevation"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:gravity="center"
                            android:textColor="@color/ml_primary"
                            android:textSize="@dimen/profile_avatar_text"
                            tools:text="E" />

                        <ImageView
                            android:layout_width="@dimen/profile_avatar_badge"
                            android:layout_height="@dimen/profile_avatar_badge"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="@dimen/profile_avatar_badge_offset"
                            android:layout_marginBottom="@dimen/profile_avatar_badge_offset"
                            android:elevation="@dimen/memory_tape_elevation"
                            android:src="@drawable/ic_logo_mark"
                            tools:ignore="ContentDescription" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/profile_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_md"
                        android:ellipsize="middle"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Title"
                        tools:text="elif.yilmaz@example.test" />

                    <TextView
                        android:id="@+id/profile_owner_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_xs"
                        android:gravity="center"
                        android:text="@string/profile_owner_note"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Note.Accent" />

                    <!-- Signed out only: what to do, and the way in. -->
                    <TextView
                        android:id="@+id/profile_session_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_md"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center"
                        android:text="@string/profile_signed_out"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Body.Muted"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profile_sign_in"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_md"
                        android:text="@string/profile_sign_in"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="@dimen/profile_tape_width"
                android:layout_height="@dimen/profile_tape_height"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/memory_tape"
                android:elevation="@dimen/memory_tape_elevation"
                android:importantForAccessibility="no"
                android:rotation="3" />
        </FrameLayout>

        <!-- Memory calendar: only while signed in. -->
        <LinearLayout
            android:id="@+id/profile_calendar_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_lg"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calendar_section_title"
                android:textAppearance="@style/TextAppearance.MemoryLane.Label" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MemoryLane.Card.Scrapbook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ml_space_sm">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true">

                    <com.memorylane.feature.calendar.ui.MemoryCalendarView
                        android:id="@+id/profile_calendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <com.memorylane.core.ui.widget.StateView
                        android:id="@+id/profile_calendar_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/ml_space_lg" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Account: only while signed in. -->
        <LinearLayout
            android:id="@+id/profile_account_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_lg"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_section_account"
                android:textAppearance="@style/TextAppearance.MemoryLane.Label" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MemoryLane.Card.Scrapbook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ml_space_sm"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/Widget.MemoryLane.ProfileRow"
                        android:focusable="true">

                        <ImageView
                            style="@style/Widget.MemoryLane.ProfileRow.Icon"
                            android:src="@drawable/login_email"
                            tools:ignore="ContentDescription" />

                        <LinearLayout style="@style/Widget.MemoryLane.ProfileRow.Texts">

                            <TextView
                                style="@style/Widget.MemoryLane.ProfileRow.Label"
                                android:text="@string/profile_email_label" />

                            <TextView
                                android:id="@+id/profile_email_value"
                                style="@style/Widget.MemoryLane.ProfileRow.Value"
                                android:ellipsize="middle"
                                android:singleLine="true"
                                tools:text="elif.yilmaz@example.test" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/Widget.MemoryLane.ProfileRow.Divider" />

                    <LinearLayout
                        style="@style/Widget.MemoryLane.ProfileRow"
                        android:focusable="true">

                        <ImageView
                            style="@style/Widget.MemoryLane.ProfileRow.Icon"
                            android:src="@drawable/login_lock"
                            tools:ignore="ContentDescription" />

                        <LinearLayout style="@style/Widget.MemoryLane.ProfileRow.Texts">

                            <TextView
                                style="@style/Widget.MemoryLane.ProfileRow.Label"
                                android:text="@string/profile_session_title" />

                            <TextView
                                style="@style/Widget.MemoryLane.ProfileRow.Value"
                                android:text="@string/profile_session_value" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- App: server status (tap to check again after an error) and version. -->
        <TextView
            android:id="@+id/profile_app_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_lg"
            android:text="@string/profile_section_app"
            android:textAppearance="@style/TextAppearance.MemoryLane.Label" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/profile_app_card"
            style="@style/Widget.MemoryLane.Card.Scrapbook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_sm"
            app:contentPadding="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/health_row"
                    style="@style/Widget.MemoryLane.ProfileRow"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/health_icon"
                        style="@style/Widget.MemoryLane.ProfileRow.Icon"
                        android:src="@drawable/ic_status_ok"
                        app:tint="@null"
                        tools:ignore="ContentDescription" />

                    <LinearLayout style="@style/Widget.MemoryLane.ProfileRow.Texts">

                        <TextView
                            style="@style/Widget.MemoryLane.ProfileRow.Label"
                            android:text="@string/health_section_title" />

                        <TextView
                            android:id="@+id/health_status"
                            style="@style/Widget.MemoryLane.ProfileRow.Value"
                            android:accessibilityLiveRegion="polite"
                            tools:text="Sunucu bağlantısı hazır" />

                        <TextView
                            android:id="@+id/health_detail"
                            style="@style/Widget.MemoryLane.ProfileRow.Value"
                            tools:text="Veritabanı: UP" />

                        <TextView
                            android:id="@+id/health_address"
                            style="@style/Widget.MemoryLane.ProfileRow.Value"
                            tools:text="Adres: http://10.0.2.2:8080/" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/health_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/health_checking"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorSize="@dimen/profile_row_icon" />
                </LinearLayout>

                <View style="@style/Widget.MemoryLane.ProfileRow.Divider" />

                <LinearLayout
                    style="@style/Widget.MemoryLane.ProfileRow"
                    android:focusable="true">

                    <ImageView
                        style="@style/Widget.MemoryLane.ProfileRow.Icon"
                        android:src="@drawable/ic_info"
                        tools:ignore="ContentDescription" />

                    <LinearLayout style="@style/Widget.MemoryLane.ProfileRow.Texts">

                        <TextView
                            style="@style/Widget.MemoryLane.ProfileRow.Label"
                            android:text="@string/profile_version_label" />

                        <TextView
                            android:id="@+id/profile_version"
                            style="@style/Widget.MemoryLane.ProfileRow.Value"
                            tools:text="0.1.0" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Signing out ends the session on this device; kept apart from the other rows. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_sign_out"
            style="@style/Widget.MemoryLane.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_lg"
            android:text="@string/profile_sign_out"
            android:textColor="@color/ml_error"
            android:visibility="gone"
            app:strokeColor="@color/ml_error"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
