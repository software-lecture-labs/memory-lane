<?xml version="1.0" encoding="utf-8"?>
<!-- ML-15 map picker: tap to place the memory's point; no location permission is used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ml_space_md">

        <ImageButton
            android:id="@+id/picker_back"
            android:layout_width="@dimen/ml_button_height"
            android:layout_height="@dimen/ml_button_height"
            android:background="@drawable/memory_create_back_bg"
            android:contentDescription="@string/memory_location_picker_back"
            android:src="@drawable/register_back"
            app:tint="@color/ml_plum" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ml_space_md"
            android:layout_weight="1"
            android:text="@string/memory_location_picker_title"
            android:textAppearance="@style/TextAppearance.MemoryLane.Headline" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.maplibre.android.maps.MapView
            android:id="@+id/picker_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_margin="@dimen/ml_space_md"
            android:background="@drawable/memory_pill_lavender"
            android:paddingHorizontal="@dimen/ml_space_md"
            android:paddingVertical="@dimen/ml_space_sm"
            android:text="@string/memory_location_picker_hint"
            android:textAppearance="@style/TextAppearance.MemoryLane.Label.Bold" />

        <TextView
            android:id="@+id/picker_tiles_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/ml_space_lg"
            android:background="@drawable/memory_pill_pink"
            android:gravity="center"
            android:paddingHorizontal="@dimen/ml_space_md"
            android:paddingVertical="@dimen/ml_space_sm"
            android:text="@string/memory_location_picker_tiles_error"
            android:textAppearance="@style/TextAppearance.MemoryLane.Label"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ml_space_md">

        <TextView
            android:id="@+id/picker_coordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.MemoryLane.Label.Bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/picker_confirm"
            style="@style/Widget.MemoryLane.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_md"
            android:text="@string/memory_location_picker_confirm"
            app:icon="@drawable/ic_location"
            app:iconGravity="textStart"
            app:iconTint="@color/ml_on_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/picker_remove"
            style="@style/Widget.MemoryLane.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_sm"
            android:text="@string/memory_location_picker_remove"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
