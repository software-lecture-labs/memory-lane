<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ml_space_lg"
        android:paddingBottom="@dimen/ml_space_lg">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ImageView
            android:layout_width="@dimen/memory_delete_icon_circle"
            android:layout_height="@dimen/memory_delete_icon_circle"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/memory_icon_circle_peach"
            android:importantForAccessibility="no"
            android:padding="@dimen/ml_space_md"
            android:src="@drawable/ic_delete"
            app:tint="@color/ml_primary" />

        <TextView
            android:id="@+id/delete_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_md"
            android:gravity="center"
            android:text="@string/memory_delete_heading"
            android:textAppearance="@style/TextAppearance.MemoryLane.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_xs"
            android:gravity="center"
            android:text="@string/memory_delete_message"
            android:textAppearance="@style/TextAppearance.MemoryLane.Body.Muted" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MemoryLane.Card.Scrapbook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ml_space_md">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/delete_cover"
                    android:layout_width="@dimen/memory_delete_cover"
                    android:layout_height="@dimen/memory_delete_cover"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@color/memory_pink_soft"
                    app:shapeAppearance="@style/ShapeAppearance.MemoryLane.Cover" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ml_space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/delete_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.MemoryLane.CardTitle" />

                    <TextView
                        android:id="@+id/delete_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_xs"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Caption" />

                    <TextView
                        android:id="@+id/delete_photo_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_xs"
                        android:background="@drawable/memory_pill_lavender"
                        android:paddingHorizontal="@dimen/ml_space_sm"
                        android:paddingVertical="@dimen/ml_space_xs"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Label.Bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_md"
            android:background="@drawable/memory_note_mint"
            android:padding="@dimen/ml_space_md"
            android:text="@string/memory_delete_gallery_note"
            android:textAppearance="@style/TextAppearance.MemoryLane.Label" />

        <LinearLayout
            android:id="@+id/delete_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_md"
            android:background="@drawable/memory_note_error"
            android:orientation="vertical"
            android:padding="@dimen/ml_space_md"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memory_delete_failed"
                android:textAppearance="@style/TextAppearance.MemoryLane.Label.Bold" />

            <TextView
                android:id="@+id/delete_error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ml_space_xs"
                android:textAppearance="@style/TextAppearance.MemoryLane.Label" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_confirm"
            style="@style/Widget.MemoryLane.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_lg"
            android:text="@string/memory_delete_confirm"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconTint="@color/ml_on_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_cancel"
            style="@style/Widget.MemoryLane.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_sm"
            android:text="@string/memory_delete_cancel" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
