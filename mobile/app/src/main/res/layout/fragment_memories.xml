<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ml_space_md">

        <com.memorylane.core.ui.widget.ScreenHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:headerSubtitle="@string/memories_subtitle"
            app:headerTitle="@string/memories_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/memory_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/memory_login" />

        <LinearLayout
            android:id="@+id/memory_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memory_form_title"
                android:textAppearance="@style/TextAppearance.MemoryLane.Title" />

            <!-- Text is not truncated: the counter turns red over the limit and saving is refused. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/memory_title_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ml_space_sm"
                android:hint="@string/memory_title_hint"
                app:counterEnabled="true"
                app:counterMaxLength="100">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/memory_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/memory_description_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ml_space_sm"
                android:hint="@string/memory_description_hint"
                app:counterEnabled="true"
                app:counterMaxLength="3000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/memory_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="3"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ml_space_sm"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/memory_date"
                    style="@style/Widget.MemoryLane.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/memory_date_select" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/memory_today"
                    style="@style/Widget.MemoryLane.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ml_space_sm"
                    android:text="@string/memory_date_today" />
            </LinearLayout>

            <TextView
                android:id="@+id/memory_date_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.MemoryLane.Body.Muted"
                android:textColor="@color/ml_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ml_space_md"
                android:text="@string/memory_category_label"
                android:textAppearance="@style/TextAppearance.MemoryLane.Label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/memory_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:saveEnabled="false"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ml_space_sm"
                android:text="@string/memory_emotion_label"
                android:textAppearance="@style/TextAppearance.MemoryLane.Label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/memory_emotions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:saveEnabled="false"
                app:singleSelection="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ml_space_sm"
                android:text="@string/memory_location_label"
                android:textAppearance="@style/TextAppearance.MemoryLane.Label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/memory_latitude_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/memory_latitude_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/memory_latitude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal|numberSigned"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/memory_longitude_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ml_space_sm"
                    android:layout_weight="1"
                    android:hint="@string/memory_longitude_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/memory_longitude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal|numberSigned"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/memory_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ml_space_md"
                android:text="@string/memory_save" />

            <TextView
                android:id="@+id/memory_save_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/memory_refresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memory_load" />

            <LinearLayout
                android:id="@+id/memory_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/memory_list_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/memory_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memory_more"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/memory_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memory_logout" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_lg"
            android:text="@string/health_section_title"
            android:textAppearance="@style/TextAppearance.MemoryLane.Label" />

        <!-- Shown only after a successful health response. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/health_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_sm"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/ml_icon_status"
                    android:layout_height="@dimen/ml_icon_status"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_status_ok" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ml_space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/health_ok_title"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Title" />

                    <TextView
                        android:id="@+id/health_database"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ml_space_xs"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Body.Muted"
                        tools:text="Veritabanı: UP" />

                    <TextView
                        android:id="@+id/health_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.MemoryLane.Body.Muted"
                        tools:text="Adres: http://10.0.2.2:8080/" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.memorylane.core.ui.widget.StateView
            android:id="@+id/health_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ml_space_lg" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
