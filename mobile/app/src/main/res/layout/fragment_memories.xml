<?xml version="1.0" encoding="utf-8"?>
<!-- Memory list. The header area scrolls away with the list (AppBarLayout "scroll"), the add
     button stays above the bottom navigation, and the list pads its bottom so the last card can
     scroll clear of the button (clipToPadding=false). Top inset is applied by MainActivity. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/memory_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ml_canvas"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ml_space_md"
            android:paddingTop="@dimen/ml_space_md"
            app:layout_scrollFlags="scroll">

            <!-- The app's mark beside the notebook badge; decorative, the title names the screen.
                 A compound drawable would put the mark inside the butter pill, so two views. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ml_space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="@dimen/memory_header_logo"
                    android:layout_height="@dimen/memory_header_logo"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo_mark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ml_space_sm"
                    android:background="@drawable/memory_pill_butter"
                    android:paddingHorizontal="@dimen/ml_space_md"
                    android:paddingVertical="@dimen/ml_space_xs"
                    android:text="@string/memory_list_badge"
                    android:textAppearance="@style/TextAppearance.MemoryLane.Label.Bold" />
            </LinearLayout>

            <com.memorylane.core.ui.widget.ScreenHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerSubtitle="@string/memory_list_subtitle"
                app:headerTitle="@string/memories_title" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/memory_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/ml_space_md"
            android:paddingTop="@dimen/ml_space_md"
            android:paddingBottom="@dimen/memory_list_bottom_padding"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_memory" />

        <!-- Loading, empty, error and signed-out states; scrolls when the screen is short
             (landscape) so the message and its button stay reachable. Top-aligned on purpose:
             with a scrolling header this view is taller than the visible area, so centring
             would push the message down behind the add button. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/memory_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/memory_list_bottom_padding"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/ml_space_lg"
                android:paddingTop="@dimen/memory_status_top"
                android:paddingBottom="@dimen/ml_space_lg">

                <com.memorylane.core.ui.widget.StateView
                    android:id="@+id/memory_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/memory_sign_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ml_space_md"
                    android:text="@string/memory_list_sign_in"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/memory_add"
        style="@style/Widget.MemoryLane.ExtendedFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/ml_space_md"
        android:contentDescription="@string/memory_list_add_description"
        android:text="@string/memory_list_add"
        app:icon="@drawable/ic_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
