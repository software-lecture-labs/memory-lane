# backend/.env olarak kaydedin. Connect > Session pooler bilgilerini kullanin.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=./config/supabase-ca.crt&currentSchema=memorylane
SPRING_DATASOURCE_USERNAME=memorylane_app.loyumebnkmulkhkahmeh
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SPRING_FLYWAY_ENABLED=false
SPRING_FLYWAY_SCHEMAS=memorylane
SPRING_FLYWAY_DEFAULT_SCHEMA=memorylane
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=3
SERVER_PORT=8080
